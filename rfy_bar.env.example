# Designed by N8JRD - Jim Davis, Vibe Coded with Claude
# Copy this file to rfy_bar.env and fill in the two required values.
# Never share or commit rfy_bar.env (it holds your webhook secret and bar token).
# On Linux/macOS also run:  chmod 600 rfy_bar.env

# ---- REQUIRED -------------------------------------------------------------
# Signing secret exactly as V4 shows it (starts with whsec_)
# Found in Settings->Connections->Webhooks->Manage (in V4)

RFY_WEBHOOK_SECRET=whsec_PASTE_YOUR_SECRET_HERE

# The NAMED ACCESS TOKEN you created on the bar (not the 4-10 digit access key)
# You must generate a Busy Bar token POST /api/access/tokens
# Recommended name {"name": "rfy-receiver"}

RFY_BAR_TOKEN=PASTE_YOUR_BAR_TOKEN_HERE

# Where things are -------------------------------------------------------
# Use your Busy Bar URL or IP Address

RFY_BAR_URL=http://192.168.0.XXX

# Local listener. Keep 127.0.0.1 because the receiver runs on the same PC as V4.

RFY_HOST=127.0.0.1
RFY_PORT=8787
RFY_PATH=/webhook

# ADVANCED CUSTOMIZATION BELOW (NOT REQUIRED)

# ---- Display behaviour (defaults shown; all optional) ----------------------
# Seconds each item stays on screen (long titles are stretched up to the max)
# RFY_DWELL_SECONDS=15
# RFY_MAX_DWELL_SECONDS=40
# While more than RFY_BACKLOG_THRESHOLD items wait, show each one for less
# RFY_BACKLOG_DWELL_SECONDS=8
# RFY_BACKLOG_THRESHOLD=5
# Pause between items
# RFY_GAP_SECONDS=1
# Retry interval while a BUSY/CUSTOM work session blocks the screen
# RFY_BUSY_RETRY_SECONDS=10
# Title scroll speed in pixels per minute (what you tested: 1000) and the
# estimated width of one character in the small font, used to size dwell time
# RFY_SCROLL_RATE=1000
# RFY_CHAR_PX=6
# App name the bar sees, and draw priority (50 yields to work sessions)
# RFY_APP_NAME=rfy_feed
# RFY_PRIORITY=50

# ---- Icon and price colours --------------------------------------------------
# A 16x16 PNG named v4_icon.png in the SAME FOLDER as rfy_bar.env is shown on the
# left, with the text beside it. Replace the file any time; no restart needed.
# If it is missing or not 16x16, items show without it and the text starts at the
# left edge. Set RFY_ICON_FILE= (empty) to turn the icon off.
# RFY_ICON_FILE=v4_icon.png
# Price line colours, #RRGGBBAA (the title is always white)
# RFY_COLOR_NORMAL=#66CCFFFF     light blue: everything else
# RFY_COLOR_GOLD=#FF8800FF       orange: ETV of RFY_GOLD_MIN_DOLLARS or more, adds " GOLD"
# RFY_COLOR_TAXFREE=#00FF00FF    green: exactly $0.00, adds " TAX FREE"
# RFY_COLOR_UNKNOWN=#FF0000FF    red: ETV not known, shows "ETV n/a"
# RFY_GOLD_MIN_DOLLARS=100
# The TAX FREE line NEVER scrolls, so it must fit by itself. "small" was verified
# to fit on the real bar. Other fonts: tiny, normal, condensed, bold, ...
# RFY_TAXFREE_FONT=small

# ---- Queue ------------------------------------------------------------------
# Newest items win: when full, the OLDEST waiting item is dropped
# RFY_QUEUE_MAX=25
# Items waiting longer than this are discarded instead of shown as "new"
# RFY_QUEUE_EXPIRY_SECONDS=1800

# ---- LED and sound ----------------------------------------------------------
# LED blink on each item (colour is #RRGGBBAA)
# RFY_LED_ENABLED=true
# RFY_LED_COLOR=#FF8800FF
# Sound is OFF by default. To turn it on, set RFY_SOUND_ENABLED=true and exactly
# ONE of the two paths below. The bar's API docs do not list its stock sound
# names; the spec says stock paths start with "shared/". If unsure, upload your
# own .snd file via the bar and use RFY_SOUND_ASSET_PATH instead.
# RFY_SOUND_ENABLED=false
# RFY_SOUND_STOCK_PATH=
# RFY_SOUND_ASSET_PATH=

# ---- Housekeeping -----------------------------------------------------------
# RFY_DB_PATH=rfy_bar.db
# RFY_DEDUPE_TTL_HOURS=24
# RFY_TIMESTAMP_TOLERANCE_SECONDS=300
# RFY_BAR_TIMEOUT_SECONDS=5
# RFY_LOG_LEVEL=INFO
